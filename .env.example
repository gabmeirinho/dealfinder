# Copy this file to .env.local for local development.
# Do not put credentials or other secrets in this tracked example file.

# The server accepts only loopback hosts.
DEALFINDER_HOST=127.0.0.1
DEALFINDER_PORT=3000
DEALFINDER_TIMEZONE=Europe/Lisbon

# All default runtime paths are derived from this directory.
# DEALFINDER_THUMBNAILS_DIR=/absolute/path/to/thumbnails
# DEALFINDER_DATA_DIR=/absolute/path/to/dealfinder-data
DEALFINDER_SQLITE_PATH=dealfinder.sqlite
DEALFINDER_CHROMIUM_PROFILE_DIR=browser-profile
DEALFINDER_DIAGNOSTICS_DIR=diagnostics
DEALFINDER_BACKUPS_DIR=backups

DEALFINDER_DIAGNOSTICS_ENABLED=true
DEALFINDER_LOG_LEVEL=info
DEALFINDER_BACKUPS_ENABLED=true
DEALFINDER_BACKUPS_RETENTION_DAYS=30

# Optional integrations. Leave unset until setup is complete.
DEALFINDER_TELEGRAM_BOT_TOKEN=
DEALFINDER_TELEGRAM_CHAT_ID=
DEALFINDER_DEEPSEEK_API_KEY=
DEALFINDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
DEALFINDER_DEEPSEEK_MODEL=deepseek-v4-flash
